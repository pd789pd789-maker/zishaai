rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'points', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'admin'] &&
             data.points is number &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin(); // Only admins can list users
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && 
                       isValidUser(incoming()) && incoming().role == 'user' && 
                       incoming().points >= 0;
                       
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
                       isValidUser(incoming()) &&
                       (
                         isAdmin() ||
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'email', 'updatedAt'])
                         )
                       );
    }

    // Transactions Validation
    function isValidTransaction(data) {
       return data.keys().hasAll(['userId', 'amount', 'points', 'type', 'status', 'description', 'createdAt']) &&
              data.userId is string && data.userId.size() > 0 &&
              data.amount is number &&
              data.points is number &&
              data.type in ['recharge', 'consume', 'admin_adjust'] &&
              data.status in ['pending', 'completed', 'failed'] &&
              data.description is string && data.description.size() <= 500 &&
              data.createdAt is timestamp;
    }

    match /transactions/{transactionId} {
      // Users can see their own transactions, admins can see all
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Transactions should mostly be generated by secure backend or Cloud Functions,
      // but if a user wants to log a consumption or start a pending recharge from frontend:
      allow create: if isSignedIn() && isValidId(transactionId) && 
                       isValidTransaction(incoming()) && 
                       incoming().userId == request.auth.uid;
                       // Backend will verify and execute
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Samples Validation
    function isValidSample(data) {
       return data.keys().hasAll(['url', 'type', 'createdBy', 'createdAt']) &&
              data.url is string && data.url.size() <= 2000 &&
              data.type in ['sample', 'user_upload'] &&
              data.createdBy is string &&
              data.createdAt is timestamp;
    }

    match /samples/{sampleId} {
      allow read, list: if true; // Public view for samples
      
      allow create: if isSignedIn() && isValidId(sampleId) && isValidSample(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       (incoming().type == 'user_upload' || (incoming().type == 'sample' && isAdmin()));
                       
      allow update, delete: if isSignedIn() && ((existing().createdBy == request.auth.uid) || isAdmin());
    }
  }
}
